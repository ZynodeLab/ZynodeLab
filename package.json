{
  "name": "zynode-lab",
  "version": "2.0.0",
  "description": "Zero-dependency Robinhood Chain CLI for deterministic EVM contract addresses, CREATE2 diagnostics, RPC checks, and deployment code generation.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "robinhood-chain",
    "evm",
    "create2",
    "deterministic-address",
    "ethereum",
    "arbitrum",
    "cli",
    "developer-tools"
  ],
  "bin": {
    "zynode": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "smoke": "node src/cli.js create2 --deployer 0x0000000000000000000000000000000000000000 --salt 0x00 --init-code 0x00",
    "network:mainnet": "node src/cli.js network --network mainnet",
    "ci": "npm run check && npm test && npm run smoke",
    "release:check": "npm run ci && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "exports": {
    ".": "./src/lib/index.js",
    "./address": "./src/lib/address.js",
    "./create": "./src/lib/create.js",
    "./create2": "./src/lib/create2.js",
    "./network": "./src/lib/network.js",
    "./rpc": "./src/lib/rpc.js",
    "./generators": "./src/lib/generators.js"
  }
}
